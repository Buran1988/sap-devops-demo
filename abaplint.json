{
  "$schema": "https://schema.abaplint.org/schema.json",
  "global": {
    "files": "/src/**/*.*",
    "skipGeneratedFunctionGroups": false,
    "exclude": []
  },
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "begin_end_names": true,
    "xml_consistency": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "superclass_final": true,
    "unknown_types": true,
    "check_ddic": true,
    "check_include": true,
    "empty_statement": true,
    "keyword_case": {
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreGlobalClassBoundary": false,
      "ignoreKeywords": []
    },
    "whitespace_end": true,
    "colon_missing_space": true,
    "double_space": true,
    "space_before_dot": {
      "excludeNewline": true
    },
    "line_length": {
      "length": 255
    },
    "contains_tab": {
      "exclude": []
    },
    "functional_writing": {
      "ignoreExceptions": true
    },
    "exporting": true,
    "empty_line_in_statement": {
      "allowChained": false
    },
    "max_one_statement": true,
    "unused_variables": true,
    "unreachable_code": true,
    "exit_or_check": true,
    "cyclomatic_complexity": {
      "max": 20
    },
    "method_length": {
      "statements": 100,
      "errorWhenEmpty": false
    },
    "nesting": {
      "max": 5
    }
  }
}